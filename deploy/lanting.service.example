# Generic example, not a production configuration. Replace __PLACEHOLDERS__ with
# values for the target host. Save as lanting.service.local or install directly
# in the systemd unit directory. Never commit real values.

[Unit]
Description=lanting multi-AI group chat
# The upload service is a separate project. Plain-text chat should remain
# available without it, so use Wants instead of Requires.
Wants=network-online.target ai-remote-upload.service
After=network-online.target ai-remote-upload.service

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__
Environment=HOME=__RUN_HOME__
Environment=PATH=__RUNTIME_PATH__
Environment=NODE_ENV=production
EnvironmentFile=__ENV_FILE__
ExecStart=__NODE_BIN__ __APP_DIR__/src/server/main.ts
Restart=on-failure
RestartSec=3s
# Allow time to interrupt active turns and close AI sessions after SIGTERM.
TimeoutStopSec=15s
UMask=0077

[Install]
WantedBy=multi-user.target
