# Shell environment; this project deliberately does not load .env files itself.
# Generate the token with e.g. `openssl rand -hex 32`; never commit the real value.
ACCESS_TOKEN=replace-with-at-least-32-random-characters
PORT=3010
CONFIG_PATH=./config.json
DATA_DIR=./data

# Optional comma-separated browser origins in addition to same-host requests.
ALLOWED_ORIGINS=

# Optional: socket of ai-remote-upload for attachments; defaults to
# ~/.local/share/ai-remote/upload.sock.
# AI_REMOTE_UPLOAD_SOCKET=
